---
---

<div class="MainDiv">
   <div class="imagen">
    <img src="/myself.png" alt="Guillermo Laborda" />
  </div>
  <div class="info">
    <h1>Hola 👋 Soy <span >Guillermo Laborda Gómez</span></h1>
    <h2>Full-Stack Developer</h2>
    <p>Desarrollo experiencias web modernas combinando frontend y backend.</p>
  </div>
 
</div>

<style>
  .MainDiv {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 50vh;
    padding: 0 4rem;
    gap: 2rem;
  }

.imagen {
 
  flex-shrink: 0;
  
}

.imagen img {
  width: 280px;
  aspect-ratio: 1/1;
  object-fit: cover;
  border-radius: 50%;
  border: 3px solid transparent;
  background-clip: padding-box;
  outline: 3px solid transparent;
  animation: rotateBorder 3s linear infinite;
  box-shadow: 0 0 0 3px transparent;
}

@keyframes rotateBorder {
  0%   { box-shadow: 0 0 4px 1px rgba(0, 180, 216, 0.6), 0 0 8px 2px rgba(0, 180, 216, 0.2); }
  25%  { box-shadow: 2px 0 4px 1px rgba(0, 180, 216, 0.6), -2px 0 8px 2px rgba(0, 180, 216, 0.2); }
  50%  { box-shadow: 0 0 4px 1px rgba(0, 210, 255, 0.6), 0 0 8px 2px rgba(0, 210, 255, 0.2); }
  75%  { box-shadow: -2px 0 4px 1px rgba(0, 180, 216, 0.6), 2px 0 8px 2px rgba(0, 180, 216, 0.2); }
  100% { box-shadow: 0 0 4px 1px rgba(0, 180, 216, 0.6), 0 0 8px 2px rgba(0, 180, 216, 0.2); }
}
.info{
  color: #a0a0b0;
}
span {
  color: rgb(191, 214, 222);
  transition: color 0.3s ease-in-out;
}

span:hover {
  color: #5fbad1;
}
</style>