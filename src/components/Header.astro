---
import navLinks from '../data/navLinks.json'
---

<header class="site-header">

  <nav class="nav">
    {
      navLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))
    }
  </nav>

  <div class="iniciales">
    <img src="/logo.svg" alt="Guillermo Laborda" style="object-fit: contain;" />
  </div>
</header>

<style>
  .site-header {
    
    display: flex;
    width: 90vw;
    justify-content: space-around;
    align-items: center;
    margin-top: 1rem;
    backdrop-filter: blur(10px);
    background-color: rgba(46, 44, 44, 0.7);
    border-bottom: 0.1rem solid rgb(9, 157, 206);

  }

  .nav {
    display: flex;
    gap: 1rem;
    width: 75vw;
    justify-content: space-between;
   
    
  }

.iniciales {
  display: flex;
  height: 10dvb;
  aspect-ratio: 1/1;
  justify-content: center;
  align-items: center;
}

.iniciales img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
  a{
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    text-decoration: none;
    color:rgb(191, 214, 222);
    transition: all 0.3s ease-in-out;
  }
  a:hover{
    background-color: aliceblue;
    color: rgb(5, 13, 13);
  }
</style>